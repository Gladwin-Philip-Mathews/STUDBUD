# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DATABASE_PATH=studbud.db
EMAIL_MODE=stub   # stub | live (CON-009). Live also needs the SMTP_* values below
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SENDER=
# SMTP_USER=
# SMTP_PASSWORD=
BASE_URL=http://localhost:4200
# Pilot server only (IF-006, NFR-010): 1 redirects plain HTTP to HTTPS, marks the session cookie Secure and sends HSTS.
# With FORCE_HTTPS=1 the server refuses to start unless SECRET_KEY is a long random value. Keep 0 on a laptop.
FORCE_HTTPS=0
